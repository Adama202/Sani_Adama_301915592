==> [1/6] Verifying MongoDB is running
==> [2/6] Creating collections + validators (01_schema_validation.js)
Created time-series collection: crumble.oven_logs
Created collection: crumble.recipe_cards (with $jsonSchema + oneOf validator)
{
  '$jsonSchema': {
    bsonType: 'object',
    title: 'Crumble recipe card',
    required: [
      'productId',
      'name',
      'type',
      'steps',
      'bakingTimeMin',
      'bakingTempC',
      'allergens'
    ],
    properties: {
      productId: {
        bsonType: 'number',
        description: 'must be an int and is required'
      },
      name: {
        bsonType: 'string',
        description: 'must be a string and is required'
      },
      type: {
        enum: [
          'bread',
          'pastry',
          'pie',
          'cookie'
        ],
        description: 'must be one of bread/pastry/pie/cookie'
      },
      steps: {
        bsonType: 'array',
        items: {
          bsonType: 'string'
        },
        description: 'ordered list of preparation steps'
      },
      bakingTimeMin: {
        bsonType: 'number',
        minimum: 1,
        maximum: 240
      },
      bakingTempC: {
        bsonType: 'number',
        minimum: 50,
        maximum: 300
      },
      variations: {
        bsonType: 'array',
        items: {
          bsonType: 'string'
        }
      },
      allergens: {
        bsonType: 'array',
        items: {
          bsonType: 'string'
        },
        description: 'e.g. [Gluten, Eggs, Milk]'
      }
    },
    oneOf: [
      {
        properties: {
          type: {
            enum: [
              'bread'
            ]
          },
          hydrationPct: {
            bsonType: 'number',
            minimum: 50,
            maximum: 90
          },
          fermentationHours: {
            bsonType: 'number',
            minimum: 1,
            maximum: 72
          }
        },
        required: [
          'hydrationPct',
          'fermentationHours'
        ]
      },
      {
        properties: {
          type: {
            enum: [
              'pastry'
            ]
          },
          laminationFolds: {
            bsonType: 'number',
            minimum: 0,
            maximum: 6
          },
          butterPct: {
            bsonType: 'number',
            minimum: 0,
            maximum: 100
          }
        },
        required: [
          'laminationFolds',
          'butterPct'
        ]
      },
      {
        properties: {
          type: {
            enum: [
              'pie'
            ]
          },
          crustType: {
            enum: [
              'shortcrust',
              'puff',
              'flaky'
            ]
          },
          filling: {
            bsonType: 'string'
          }
        },
        required: [
          'crustType',
          'filling'
        ]
      },
      {
        properties: {
          type: {
            enum: [
              'cookie'
            ]
          },
          doughRestHours: {
            bsonType: 'number',
            minimum: 0,
            maximum: 48
          },
          spreadFactor: {
            bsonType: 'number',
            minimum: 0,
            maximum: 2
          }
        },
        required: [
          'doughRestHours',
          'spreadFactor'
        ]
      }
    ]
  }
}
